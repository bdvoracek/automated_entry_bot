  "fragments": [
    {
      "id": "frag-9",
      "focal_uid": 9,
      "title": "The crew that never sleeps",
      "insight": "A century-long crossing cannot be flown from mission control - the light delay to Alpha Centauri alone is over four years each way. Money and political commitment buy the autonomy, and once a ship can navigate, diagnose and repair itself it also unlocks the industry that builds it. Nearly every model wires this straight into the arrival date.",
      "role": "driver",
      "importance": 100,
      "aci": 0.775,
      "focal": {
