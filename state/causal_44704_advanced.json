  "fragments": [
    {
      "id": "frag-2",
      "focal_uid": 2,
      "title": "The reserve is the world's shock absorber",
      "insight": "When conflict flares or OPEC moves, governments reach for their strategic reserves \u2014 and that decision ripples straight into how full the world's storage tanks are, and into how traders bet. Almost every model wires it this way, which is why the reserve sits at the busy centre of the map: it's the lever policymakers actually pull when something goes wrong.",
      "role": "driver",
      "importance": 100,
      "aci": 0.888,
      "focal": {
