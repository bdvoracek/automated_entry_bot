  "fragments": [
    {
      "id": "frag-6",
      "focal_uid": 6,
      "title": "The spending decision everything hangs off",
      "insight": "How much Amazon pours into AI infrastructure - and how much revenue each dollar of it actually returns - sits at the busy centre of the map. Cheap money makes the build-out affordable, and the build-out is what buys cloud share and, eventually, the peak price. It is the one lever that is genuinely Amazon's own choice rather than something the world does to it, which is why almost every model routes through it.",
      "role": "mediator",
      "importance": 100,
      "aci": 0.865,
      "focal": {
